# ==============================================================================
# ENMAR Production Environment Variables (.env)
# ==============================================================================

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. LIVE DATABASE CONNECTION (cPanel MySQL / MariaDB / Cloud Database)
# ------------------------------------------------------------------------------
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME?charset=utf8mb4&collation=utf8mb4_unicode_ci
DATABASE_URL="mysql://cpanel_user:your_db_password@localhost:3306/cpanel_dbname?charset=utf8mb4&collation=utf8mb4_unicode_ci"

# ------------------------------------------------------------------------------
# 2. SITE & AUTHENTICATION URLS (Your Live Domain)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://enmar.shop"
NEXTAUTH_URL="https://enmar.shop"

# ------------------------------------------------------------------------------
# 3. SECURITY KEYS & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="enmar_nextauth_secret_key_2026_super_secure"
ENCRYPTION_SECRET="enmar_secure_master_aes_vault_key_2026_bd"
JWT_SECRET="enmar_jwt_secret_key_2026_production"

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI & THIRD-PARTY GATEWAY KEYS
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=""
