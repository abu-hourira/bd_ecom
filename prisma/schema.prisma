// prisma/schema.prisma
// ENMAR Organic Food E-Commerce Platform Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. AUTHENTICATION & USERS & RBAC STAFF
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MODERATOR
  CUSTOMER
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  role            Role      @default(CUSTOMER)
  avatar          String?   @db.Text
  address         String?   @db.Text
  city            String?   @default("Dhaka")
  postalCode      String?
  isPhoneVerified Boolean   @default(false)
  isEmailVerified Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  
  // 2FA & Security
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?  @db.Text
  failedAttempts   Int      @default(0)
  lockedUntil      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders          Order[]
  reviews         Review[]
  addresses       Address[]
  conversations   AIConversationLog[]
  comments        CommunityComment[]
  auditLogs       StaffAuditLog[]
  wellnessProfile WellnessProfile?
  returnRequests  ReturnRequest[]
  wishlist        WishlistItem[]

  @@map("users")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model RolePermission {
  id          Int      @id @default(autoincrement())
  role        Role
  module      String   // products, orders, inventory, promos, theme, settings, gateways, api, staff, returns, customers, analytics
  canRead     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([role, module])
  @@map("role_permissions")
}

model StaffAuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  userEmail   String
  userName    String
  role        Role
  action      String   // CREATE, UPDATE, DELETE, TOGGLE_GATEWAY, ROLE_CHANGE
  target      String   // e.g. "Order #ENM-1002", "Payment Gateway SSLCommerz"
  details     String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_audit_logs")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String   @default("Home")
  recipientName String
  phone         String
  streetAddress String   @db.Text
  area          String?
  city          String   @default("Dhaka")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────
// 2. PRODUCT CATALOG & CATEGORIES
// ─────────────────────────────────────────────────────────────

model Category {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  slug         String     @unique
  icon         String?    @default("leaf")
  image        String?    @db.Text
  description  String?    @db.Text
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  parentId     Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]

  @@map("categories")
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  slug              String      @unique
  categoryId        Int?
  subcategory       String?
  price             Decimal     @db.Decimal(10, 2)
  discountPrice     Decimal?    @db.Decimal(10, 2)
  stockQuantity     Int         @default(0)
  unit              String      @default("kg") // kg, g, ml, L, piece, bundle
  images            Json        // Array of image URLs
  description       String      @db.LongText
  shortDescription  String?     @db.Text
  organicCertified  Boolean     @default(true)
  isCombo           Boolean     @default(false)
  comboProductIds   Json?       // Linked product IDs for bundles
  savingsPercentage Decimal?    @db.Decimal(5, 2)
  badge             String?     // "Sale", "New", "Best Seller"
  featured          Boolean     @default(false)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  category          Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]
  reviews           Review[]
  wishlists         WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// 3. ORDERS & LIVE TRACKING SYSTEM
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                 Int            @id @default(autoincrement())
  orderNumber        String         @unique
  trackingId         String         @unique // Customer tracking token
  userId             Int?
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingAddress    String         @db.Text
  deliveryZone       String?        @default("Inside Dhaka")
  
  subtotal           Decimal        @db.Decimal(10, 2)
  discountAmount     Decimal        @default(0) @db.Decimal(10, 2)
  promoCodeId        Int?
  promoCodeText      String?
  shippingFee        Decimal        @default(70) @db.Decimal(10, 2)
  totalAmount        Decimal        @db.Decimal(10, 2)

  paymentMethod      PaymentMethod  @default(COD)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentGatewayTrx  String?
  orderStatus        OrderStatus    @default(PENDING)

  courierPartner     String?        // "Pathao", "Steadfast", "RedX", "In-House"
  courierTrackingId  String?
  deliveryPersonnelId Int?
  deliveryPersonnel   DeliveryPersonnel? @relation(fields: [deliveryPersonnelId], references: [id], onDelete: SetNull)
  estimatedDelivery  DateTime?
  cancellationReason String?        @db.Text
  refundNeeded       Boolean        @default(false)
  refundStatus       String?        @default("NOT_APPLICABLE") // "NOT_APPLICABLE", "REFUND_NEEDED", "REFUNDED"
  customerNotes      String?        @db.Text
  adminNotes         String?        @db.Text
  customerHidden     Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoCode          PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  history            OrderHistory[]
  messages           OrderMessage[]
  returnRequests     ReturnRequest[]

  @@index([trackingId])
  @@index([orderNumber])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)
  unit        String   @default("piece")
  itemImage   String?  @db.Text
  totalPrice  Decimal  @db.Decimal(10, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderHistory {
  id          Int         @id @default(autoincrement())
  orderId     Int
  status      OrderStatus
  note        String      @db.Text
  actorRole   String      @default("SYSTEM")
  actorName   String      @default("Automated System")
  createdAt   DateTime    @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_history")
}

model OrderMessage {
  id         Int      @id @default(autoincrement())
  orderId    Int
  sender     String
  senderName String
  message    String   @db.Text
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_messages")
}

// ─────────────────────────────────────────────────────────────
// 4. RETURN / REFUND / EXCHANGE WORKFLOW
// ─────────────────────────────────────────────────────────────

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REFUNDED
  EXCHANGED
}

model ReturnRequest {
  id           Int            @id @default(autoincrement())
  orderId      Int
  userId       Int?
  trackingId   String
  reason       String         @db.Text
  itemIds      Json?          // Selected item IDs
  photos       Json?          // Uploaded evidence photos
  returnType   String         @default("REFUND") // REFUND, EXCHANGE, REPLACEMENT
  status       ReturnStatus   @default(REQUESTED)
  refundAmount Decimal?       @db.Decimal(10, 2)
  adminNotes   String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  timeline     ReturnTimeline[]

  @@map("return_requests")
}

model ReturnTimeline {
  id          Int           @id @default(autoincrement())
  returnId    Int
  status      ReturnStatus
  note        String        @db.Text
  actorName   String        @default("Support Staff")
  createdAt   DateTime      @default(now())

  returnReq   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_timelines")
}

// ─────────────────────────────────────────────────────────────
// 5. PROMO CODES & COUPONS
// ─────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model PromoCode {
  id                   Int          @id @default(autoincrement())
  code                 String       @unique
  discountType         DiscountType @default(PERCENTAGE)
  discountValue        Decimal      @db.Decimal(10, 2)
  minOrderAmount       Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscountAmount    Decimal?     @db.Decimal(10, 2)
  totalUsageCap        Int?
  usageCount           Int          @default(0)
  perCustomerLimit     Int          @default(1)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean      @default(true)
  applicableCategories Json?
  applicableProductIds Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  orders               Order[]

  @@map("promo_codes")
}

// ─────────────────────────────────────────────────────────────
// 6. HEALTH & WELLNESS PROFILE (GENERAL WELLNESS ONLY)
// ─────────────────────────────────────────────────────────────

model WellnessProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  heightCm       Float?
  weightKg       Float?
  bmiValue       Float?
  bmiCategory    String?
  dailyCalorie   Int?
  waterTargetLtr Float?
  activityLevel  String?  @default("moderate")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wellness_profiles")
}

// ─────────────────────────────────────────────────────────────
// 7. NOTIFICATIONS & SUBSCRIBERS
// ─────────────────────────────────────────────────────────────

model ProductSubscriber {
  id            Int      @id @default(autoincrement())
  email         String?
  phone         String?
  categories    Json?    // Subscribed category preferences
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("product_subscribers")
}

model NotificationGateway {
  id                   Int      @id @default(autoincrement())
  channel              String   // "sms" or "email"
  provider             String   // "bulksmsbd", "alpha", "smtp", "sendgrid", "resend"
  credentialsEncrypted String   @db.Text
  senderId             String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  logs                 NotificationLog[]

  @@map("notification_gateways")
}

model NotificationLog {
  id          Int                  @id @default(autoincrement())
  gatewayId   Int?
  channel     String
  recipient   String
  subject     String?
  content     String               @db.Text
  status      String               // "SENT", "FAILED"
  errorReason String?              @db.Text
  createdAt   DateTime             @default(now())

  gateway     NotificationGateway? @relation(fields: [gatewayId], references: [id], onDelete: SetNull)

  @@map("notification_logs")
}

// ─────────────────────────────────────────────────────────────
// 8. SITE SETTINGS & THEME CUSTOMIZATION
// ─────────────────────────────────────────────────────────────

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.LongText
  group     String   @default("general")
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ThemeSetting {
  id              Int      @id @default(autoincrement())
  primaryColor    String   @default("#14421a")
  secondaryColor  String   @default("#5c3a21")
  accentColor     String   @default("#f5a623")
  backgroundColor String   @default("#fdfbf7")
  textColor       String   @default("#1f2937")
  fontHeading     String   @default("Fraunces")
  fontBody        String   @default("Work Sans")
  buttonRadius    String   @default("rounded-xl")
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("theme_settings")
}

model PromotionBanner {
  id           Int      @id @default(autoincrement())
  title        String
  headline     String?
  subtitle     String?
  imageUrl     String   @db.LongText
  targetLink   String?
  placement    String   @default("HERO_CAROUSEL")
  startDate    DateTime?
  endDate      DateTime?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  bgColor      String?  @default("#14421a")
  textColor    String?  @default("#ffffff")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("promotion_banners")
}

// ─────────────────────────────────────────────────────────────
// 9. AI INTEGRATION & CONVERSATIONS
// ─────────────────────────────────────────────────────────────

model AISetting {
  id               Int      @id @default(autoincrement())
  provider         String   @default("openai")
  apiKeyEncrypted  String   @db.Text
  modelName        String   @default("gpt-4o")
  systemPrompt     String   @db.LongText
  adminPrompt      String?  @db.LongText
  rateLimitPerMin  Int      @default(30)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("ai_settings")
}

model AIConversationLog {
  id           Int      @id @default(autoincrement())
  sessionId    String
  userId       Int?
  userMessage  String   @db.Text
  aiResponse   String   @db.Text
  tokensUsed   Int      @default(0)
  isFlagged    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("ai_conversation_logs")
}

// ─────────────────────────────────────────────────────────────
// 10. TWO-WAY API INTEGRATIONS
// ─────────────────────────────────────────────────────────────

model APIKey {
  id           Int       @id @default(autoincrement())
  name         String
  keyPrefix    String    @db.VarChar(12)
  keyHash      String    @unique
  permissions  String    @default("read:products")
  isActive     Boolean   @default(true)
  rateLimit    Int       @default(60)
  requestCount Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs         APIAccessLog[]

  @@map("api_keys")
}

model APIAccessLog {
  id        Int      @id @default(autoincrement())
  apiKeyId  Int
  endpoint  String
  ipAddress String?
  userAgent String?
  status    Int      @default(200)
  createdAt DateTime @default(now())

  apiKey    APIKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@map("api_access_logs")
}

model APIImportSource {
  id                  Int       @id @default(autoincrement())
  name                String
  endpointUrl         String    @db.Text
  authType            String    @default("bearer")
  authTokenEncrypted  String?   @db.Text
  fieldMapping        Json
  syncFrequencyHours  Int       @default(12)
  autoPublish         Boolean   @default(false)
  lastSyncAt          DateTime?
  lastStatus          String?   @default("IDLE")
  errorLog            String?   @db.Text
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("api_import_sources")
}

// ─────────────────────────────────────────────────────────────
// 11. REVIEWS, COMMUNITY, BACKUPS & RECYCLE BIN
// ─────────────────────────────────────────────────────────────

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     Int?
  userName   String
  userEmail  String
  rating     Int      @default(5)
  comment    String   @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

model CommunityComment {
  id         Int      @id @default(autoincrement())
  userId     Int?
  authorName String
  message    String   @db.Text
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("community_comments")
}

model BackupLog {
  id          Int      @id @default(autoincrement())
  fileName    String
  fileSize    Int
  recordCount Int
  createdType String   // MANUAL, SCHEDULED
  createdAt   DateTime @default(now())

  @@map("backup_logs")
}

model BinItem {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  title      String
  subtitle   String?
  payload    Json
  deletedBy  String   @default("Admin")
  createdAt  DateTime @default(now())

  @@map("recycle_bin")
}


// 12. FEATURE FLAGS & VISIBILITY CONTROL
model FeatureFlag {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?  @db.Text
  category    String   @default("general")
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}


// ─────────────────────────────────────────────────────────────
// 13. DELIVERY PERSONNEL & LIVE LOCATION TRACKING
// ─────────────────────────────────────────────────────────────

model DeliveryPersonnel {
  id                 Int       @id @default(autoincrement())
  name               String
  phone              String    @unique
  passwordHash       String
  vehicleType        String?   @default("Motorbike") // "Bicycle", "Motorbike", "Van"
  licenseNumber      String?
  isActive           Boolean   @default(true)
  isSharingLocation  Boolean   @default(false)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders             Order[]

  @@map("delivery_personnel")
}
